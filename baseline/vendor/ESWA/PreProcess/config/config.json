{
"CN-filter": {
    "raw_path": "./data/raw-data/CN-all.csv",
    "filter_code_path": "./data/New-Data/cn-code-all.csv",
    "comany_patent_path": "./data/New-Data/cn_com_all.csv",
    "company_top_path": "./data/New-Data/top30/cntpo-30.csv",
    "key_COM":[
      "orgname",
      "publicationDate",
      "patentId",
      "classCode"
    ],
    "KNN-path": "./data/CN-filter/tmp.csv",
    "hier_path": "./data/CN-filter/tmp_hieray.csv",
    "reIndex_path": "./data/CN-filter/tmp-reIndex.csv",
    "concate_path": "./data/CN-filter/tmp-concate.csv",
    "final_path": "./data/CN-filter/all.csv",

    "match_label": [
      "codeIV",
      "codeIII",
      "codeII",
      "codeI"
    ],
    "match_rule": [
      "[a-hA-H]\\d+[a-zA-Z]-?\\d+",
      "[a-hA-H]\\d+[a-zA-Z]",
      "[a-hA-H]\\d+",
      "[a-hA-H]"
    ],

    "reid_raw_col": [
      "orgname",
      "classCode",
      "codeIV",
      "codeIII",
      "codeII",
      "codeI"
    ],
    "reid_new_col": [
      "orgID",
      "codeId",
      "codeIVId",
      "codeIIIId",
      "codeIIId",
      "codeIId"
    ],
    "reid_path": [
      "./data/CN-filter/reInd/com-reInd.csv",
      "./data/CN-filter/reInd/cls-reInd.csv",
      "./data/CN-filter/reInd/clsIV-reInd.csv",
      "./data/CN-filter/reInd/clsIII-reInd.csv",
      "./data/CN-filter/reInd/clsII-reInd.csv",
      "./data/CN-filter/reInd/clsI-reInd.csv"
    ],
    "map_out": [
      "orgID",
      "group",
      "class",
      "subsection",
      "section"
    ],
    "label_3_path":"./data/CN-filter/map/clsIII.csv",
    "multi_label_train_path":"./data/CN-filter/MultiLabel/classIII_train.csv",
    "multi_label_val_path":"./data/CN-filter/MultiLabel/classIII_val.csv",
    "multi_label_test_path":"./data/CN-filter/MultiLabel/classIII_test.csv",
    "multi_label_path":"./data/MultiLabel/patent_data_multilabel.csv",
    "eda_path": "./data/CN-EDA/eda.csv"
  },

