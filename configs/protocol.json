{
  "version": "raw-annual-v2",
  "observation_start_year": {"cn": 2010, "us": 2010, "in": 2018},
  "last_year_policy": "latest_year_with_12_months_and_consecutive_validation_history",
  "source": "complete_raw_corpora",
  "raw_files": {"cn": "datasets/CN-all.csv", "us": "datasets/US-all.csv", "in": "datasets/IN-all.csv"},
  "taxonomy_source": "datasets/patent_{country}/IPC{Section,Class,SubClass}[_US].csv",
  "input_gate": "transfer_closed_and_stable_then_full_csv_scan_and_sha256",
  "languages": ["cn", "in", "us"],
  "prediction_horizon": "next_calendar_year",
  "top_sections_by": "train_distinct_subclasses",
  "prediction_level": 3,
  "validation": "penultimate_observed_year",
  "test": "last_observed_year",
  "same_timestamp": "read_before_group_write",
  "candidate_policy": "train_observed_ipc_with_oov_targets_counted_as_misses",
  "organization_identity": "normalized_original_applicant_name",
  "entity_scope": "organizations",
  "entity_screen": "explicit_name_rules_v1_with_unresolved_separate",
  "taxonomy_unknown_policy": "retain_raw_quarantine_from_main_views",
  "empty_targets": "retain_report_separately",
  "collaborators": 3,
  "word2vec_dim": 100,
  "seeds": [42, 2026, 3407],
  "ranking_ks": [10, 20, 30, 40],
  "selection_metric": "validation_ndcg_20",
  "source_limitations": ["IN original header has no title or patent publication number", "raw applicant fields do not reliably distinguish companies from individuals"]
}
