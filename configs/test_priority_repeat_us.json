{
  "name": "test_priority_repeat_us",
  "policy": {
    "seed": 42,
    "priority": "test",
    "validation_repeats": false,
    "note": "Replay existing checkpoints; train missing cells once, then evaluate validation and test."
  },
  "jobs": [
    {
      "id": "test_US_C_RepeatMixer_s42",
      "argv": [
        "scripts/train_sampling_baseline.py",
        "--dataset",
        "US_C",
        "--method",
        "RepeatMixer",
        "--seed",
        "42",
        "--tag",
        "v2_default",
        "--device",
        "{device}",
        "--resume",
        "--evaluate-test"
      ],
      "output": "results/deep/US_C/RepeatMixer/v2_default/s42/metrics.json",
      "requires": [
        "data/text/us/manifest.json",
        "results/deep/IN_B/RepeatMixer/pilot_cached_v2/s42/validation.json"
      ],
      "minimum_free_mb": 2200
    },
    {
      "id": "test_US_F_RepeatMixer_s42",
