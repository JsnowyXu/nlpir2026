    "note": "Replay existing checkpoints; train missing cells once, then evaluate validation and test."
  },
  "jobs": [
    {
      "id": "test_IN_B_IDGP_s42",
      "argv": [
        "scripts/train_temporal_baseline.py",
        "--dataset",
        "IN_B",
        "--method",
        "IDGP",
        "--seed",
        "42",
        "--tag",
        "v2_default",
        "--device",
        "{device}",
        "--resume",
        "--evaluate-test"
      ],
      "output": "results/deep/IN_B/IDGP/v2_default/s42/metrics.json",
